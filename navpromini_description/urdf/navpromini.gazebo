<?xml version="1.0" ?>
<robot name="NavProMini" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Physical parameters for NavProMini V2
       Wheel: 68 mm diameter → radius 0.034 m
       Track: 23 cm → 0.23 m (wheel-to-wheel separation distance)
  -->
  <xacro:property name="wheel_radius" value="0.034"/>
  <xacro:property name="wheel_separation" value="0.23"/>
  <xacro:property name="max_linear_velocity" value="0.6"/>
  <xacro:property name="max_angular_velocity" value="2.5"/>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <visual>
      <material>
        <ambient>0.15 0.15 0.15 1.0</ambient>
        <diffuse>0.15 0.15 0.15 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="case">
    <material>Gazebo/Orange</material>
    <visual>
      <material>
        <ambient>1.0 0.45 0.05 1.0</ambient>
        <diffuse>1.0 0.45 0.05 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="cheeseplate">
    <material>Gazebo/FlatBlack</material>
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.08 0.08 0.08 1.0</diffuse>
        <specular>0.1 0.1 0.1 1.0</specular>
      </material>
    </visual>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="flcl">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="flcr">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="blc">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leftWheel">
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxContacts>8</maxContacts>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="rightWheel">
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxContacts>8</maxContacts>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- Slippery caster wheels: support robot weight but do not fight diff-drive -->
  <gazebo reference="bc">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <slip1>1.0</slip1>
    <slip2>1.0</slip2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxContacts>4</maxContacts>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="fcr">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <slip1>1.0</slip1>
    <slip2>1.0</slip2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxContacts>4</maxContacts>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="fcl">
    <material>Gazebo/White</material>
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1.0</ambient>
        <diffuse>0.95 0.95 0.95 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <slip1>1.0</slip1>
    <slip2>1.0</slip2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxContacts>4</maxContacts>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- Lenovo 300 FHD Webcam (Rear Camera: 1080p @ 30fps, 95° DFOV ~ 1.46 rad HFOV) -->
  <gazebo reference="camera_link">
    <material>Gazebo/FlatBlack</material>
    <visual>
      <material>
        <ambient>0.08 0.08 0.08 1.0</ambient>
        <diffuse>0.08 0.08 0.08 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
    <sensor name="lenovo_300_fhd_webcam" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30.0</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.46</horizontal_fov>
        <image>
          <width>1920</width>
          <height>1080</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- RPLIDAR A1M8 -->
  <gazebo reference="lidar">
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0.4 0.4 0.4 1</specular>
      </material>
    </visual>
    <sensor name="rplidar_a1m8" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>5.5</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_1</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28318530718</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <!-- Drive from /cmd_vel. Wheel odom only (no TF) — TF comes from ground-truth pose. -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>LeftWheelJoint</left_joint>
      <right_joint>RightWheelJoint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <min_linear_velocity>${-1.0 * max_linear_velocity}</min_linear_velocity>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <min_angular_velocity>${-1.0 * max_angular_velocity}</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom_wheels</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Ground-truth odom + TF from actual Gazebo pose -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>LeftWheelJoint</joint_name>
      <joint_name>RightWheelJoint</joint_name>
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>

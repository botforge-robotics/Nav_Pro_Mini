<?xml version="1.0" ?>
<robot name="NavProMini" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- RViz materials: body orange, wheels black, remaining white -->
  <material name="orange">
    <color rgba="1.0 0.45 0.05 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

</robot>

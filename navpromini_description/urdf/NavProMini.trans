<?xml version="1.0" ?>
<robot name="NavProMini" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Motor actuators: 10 kg.cm (0.981 N.m), 300 RPM -->
  <xacro:property name="motor_effort" value="0.981"/>
  <xacro:property name="motor_velocity" value="31.416"/>

  <transmission name="LeftWheelJoint_tran">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="LeftWheelJoint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
      <maxEffort>${motor_effort}</maxEffort>
      <maxVelocity>${motor_velocity}</maxVelocity>
    </actuator>
  </transmission>

  <transmission name="RightWheelJoint_tran">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="RightWheelJoint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="right_wheel_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
      <maxEffort>${motor_effort}</maxEffort>
      <maxVelocity>${motor_velocity}</maxVelocity>
    </actuator>
  </transmission>

</robot>

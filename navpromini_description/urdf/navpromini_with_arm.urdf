  <!-- Camera (Rear-facing: 14mm dia circular body, 2mm thick)
       Mounted above BLC link +ve z axis by 25.6mm, facing in -x direction -->
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.020"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
    <visual>
      <!-- Circular camera body: 14mm diameter (r=7mm), 2mm thick -->
      <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.007"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <!-- Inner lens optic (8mm diameter) -->
      <origin rpy="0 1.57079632679 0" xyz="0.0005 0 0"/>
      <geometry>
        <cylinder length="0.0015" radius="0.004"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <visual>
      <!-- Center optical aperture (4mm diameter) -->
      <origin rpy="0 1.57079632679 0" xyz="0.0011 0 0"/>
      <geometry>
        <cylinder length="0.0005" radius="0.002"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.002" radius="0.007"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 0 3.14159265359" xyz="0.0 0.0 0.0256"/>
    <parent link="blc"/>
    <child link="camera_link"/>
  </joint>
  <!-- Standard REP-103 Camera Optical Frame (+Z forward out of lens, +X right, +Y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>
  <!-- Compatibility optical alias -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">

<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Optional Wrist Camera Attachment (from so101_new_calib_camera.urdf) -->
  <xacro:macro name="so101_wrist_camera" params="parent:=gripper_link">
    <link name="wrist_camera_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.02"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://navpromini_description/meshes/so101/wrist_camera_mount_so101_v1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="so101_3d_printed"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://navpromini_description/meshes/so101/wrist_camera_mount_so101_v1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="wrist_camera_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.015"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://navpromini_description/meshes/so101/wrist_camera_so101_v1.stl"/>
        </geometry>
        <material name="so101_sts3215"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://navpromini_description/meshes/so101/wrist_camera_so101_v1.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="wrist_camera_mount_joint" type="fixed">
      <origin xyz="-0.0150 0.0240 -0.0315" rpy="-1.5708 -0.0008 -1.5708"/>
      <parent link="${parent}"/>
      <child link="wrist_camera_mount_link"/>
    </joint>

    <joint name="wrist_camera_joint" type="fixed">
      <origin xyz="-0.04941 -0.03813 0.0175" rpy="0 -1.5708 -2.0076"/>
      <parent link="wrist_camera_mount_link"/>
      <child link="wrist_camera_link"/>
    </joint>

    <!-- Standard ROS REP-103 Camera Optical Frame (Z forward, X right, Y down) -->
    <link name="wrist_camera_optical_frame"/>
    <joint name="wrist_camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
      <parent link="wrist_camera_link"/>
      <child link="wrist_camera_optical_frame"/>
    </joint>

    <!-- Gazebo Sim Sensor: SO101 Wrist Camera on Gripper -->
    <gazebo reference="wrist_camera_link">
      <sensor name="so101_wrist_camera" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30.0</update_rate>
        <topic>arm/wrist_camera/image_raw</topic>
        <gz_frame_id>wrist_camera_optical_frame</gz_frame_id>
        <camera>
          <camera_info_topic>arm/wrist_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navpromini_fleet</name>
  <version>0.1.0</version>
  <description>NavPro Mini on-robot fleet agent: provisioning portal, heartbeat, display, zenoh</description>
  <maintainer email="todo@todo.com">author</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>navpromini_controller</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

// Zenoh ROS2DDS CLIENT template for a real NavPro Mini robot.
// install_zenoh_bridge.sh / start_fleet.sh substitute:
//   __SERVER_IP__  __ROBOT_NAME__  __ROS_DOMAIN_ID__
{
  mode: "client",
  connect: {
    endpoints: ["tcp/__SERVER_IP__:7447"],
  },
  scouting: {
    multicast: { enabled: false },
  },
  timestamping: {
    enabled: true,
    drop_future_timestamp: false,
  },
  plugins: {
    ros2dds: {
      nodename: "navpro_zenoh___ROBOT_NAME__",
      namespace: "/__ROBOT_NAME__",
      domain: __ROS_DOMAIN_ID__,
      allow: {
        publishers: [
          ".*/amcl_pose",
          ".*/battery_state",
          ".*/battery/state",
          ".*/robot_mode",
          ".*/tf",
          ".*/tf_static",
          ".*/map",
          ".*/mapping_grid",
          ".*/odom",
          ".*/heartbeat",
          ".*/mapping_status",
          ".*/mapping_pose",
          ".*/mapping_scan",
        ],
        subscribers: [
          ".*/mapping_cmd",
          ".*/fleet_cmd",
          ".*/fleet_teleop",
        ],
        service_servers: [],
        service_clients: [],
        action_servers: [
          ".*/navigate_to_pose",
        ],
        action_clients: [],
      },
      pub_max_frequencies: [
        ".*/amcl_pose=5",
        ".*/tf=10",
        ".*/tf_static=1",
        ".*/battery_state=1",
        ".*/battery/state=1",
        ".*/robot_mode=2",
        ".*/odom=5",
        ".*/map=2",
        ".*/mapping_grid=2",
      ],
    },
  },
}

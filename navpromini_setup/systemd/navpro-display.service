[Unit]
Description=NavPro Mini OLED/LED status display (dynamic via hint file + topic)
# Start with NetworkManager so setup hotspot can update OLED/LED even if
# hardware bringup is still starting or failed.
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Environment=NAVPRO_USER=REPLACE_USER
Environment=NAVPRO_WS=REPLACE_WS
Environment=ROS_LOCALHOST_ONLY=1
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash /opt/navpro/scripts/start_display.sh
Restart=on-failure
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target

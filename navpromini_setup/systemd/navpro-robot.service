[Unit]
Description=NavPro Mini hardware bringup (lidar, odom, micro-ROS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=NAVPRO_USER=REPLACE_USER
Environment=NAVPRO_WS=REPLACE_WS
# 0 required so PC Mission Planner web UI / rosbridge LAN clients can see the graph
Environment=ROS_LOCALHOST_ONLY=0
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash /opt/navpro/scripts/start_robot.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

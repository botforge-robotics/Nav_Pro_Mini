    <!-- Gentle Terrain Incline Platform (Ramp Up, Flat Top, Ramp Down) -->
    <!--
      Length: 3.0m total (1.0m incline, 1.0m plateau at h=0.06m, 1.0m decline)
      Gentle slope ~3.4 deg, perfectly climbable by differential drive robot
    -->
    <model name="terrain_ramp">
      <static>true</static>
      <pose>8.0 -8.5 0 0 0 0</pose>
      <link name="link">
        <!-- Incline wedge -->
        <collision name="c_ramp_up">
          <pose>-1.0 0 0.03 0 0.06 0</pose>
          <geometry><box><size>1.0 1.2 0.06</size></box></geometry>
        </collision>
        <visual name="v_ramp_up">
          <pose>-1.0 0 0.03 0 0.06 0</pose>
          <geometry><box><size>1.0 1.2 0.06</size></box></geometry>
          <material><ambient>0.35 0.45 0.4 1</ambient><diffuse>0.35 0.45 0.4 1</diffuse></material>
        </visual>
        <!-- Plateau -->
        <collision name="c_plateau">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.06</size></box></geometry>
        </collision>
        <visual name="v_plateau">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>1.0 1.2 0.06</size></box></geometry>
          <material><ambient>0.4 0.5 0.45 1</ambient><diffuse>0.4 0.5 0.45 1</diffuse></material>
        </visual>
        <!-- Decline wedge -->

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navpromini_navigation</name>
  <version>0.0.0</version>
  <description>Nav2 navigation stack for NavProMini</description>
  <maintainer email="todo@todo.com">author</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>nav2_common</depend>

  <!-- Meta packages pull the full Nav2 stack for rosdep -->
  <depend>navigation2</depend>
  <depend>nav2_bringup</depend>

  <!-- Explicit Nav2 nodes used by params / bringup -->
  <depend>nav2_amcl</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_waypoint_follower</depend>
  <depend>nav2_velocity_smoother</depend>
  <depend>nav2_smoother</depend>
  <depend>nav2_collision_monitor</depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_dwb_controller</depend>

  <depend>rviz2</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Maps saved by mapping package -->
  <exec_depend>navpromini_mapping</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
